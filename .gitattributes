# توحيد نهايات الأسطر تلقائياً
* text=auto eol=lf

# ملفات Windows فقط
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# ملفات يجب أن تبقى كما هي (بدون تحويل)
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.svg           text eol=lf
*.woff          binary
*.woff2         binary
*.ttf           binary
*.eot           binary
*.mp3           binary
*.mp4           binary
*.wav           binary

# ملفات المصدر
*.js            text eol=lf
*.jsx           text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.json          text eol=lf
*.css           text eol=lf
*.scss          text eol=lf
*.html          text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# منع دمج ملفات lock تلقائياً (تجنب التعارضات)
package-lock.json  merge=binary
yarn.lock          merge=binary
pnpm-lock.yaml     merge=binary